# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "remote" loads photos straight from hotelseaview.in.
# Run `npm run fetch-images`, then set this to "local" to serve them from /public/images.
VITE_IMAGE_SOURCE=remote

# Set to "true" to use the local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false

# ---- Used only by `npm run create-users` (never shipped to the browser) ----
# Path to a service-account JSON from Firebase console > Project settings > Service accounts
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
ADMIN_EMAIL=admin@hotelseaview.in
ADMIN_PASSWORD=
ADMIN_NAME=Front Desk Admin
GUEST_EMAIL=guest@example.com
GUEST_PASSWORD=
GUEST_NAME=Sample Guest
