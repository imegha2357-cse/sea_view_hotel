rules_version = '2';

// PRD 7.2: deny public reads, validate every field on the server, least-privilege access.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------
    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    // Any staff member (admins/{uid} exists). Roles: owner | desk | viewer. A missing role means owner.
    function isAdmin() { return signedIn() && exists(staffPath()); }
    function staffRole() { return get(staffPath()).data.get('role', 'owner'); }
    function canEdit() { return isAdmin() && staffRole() != 'viewer'; }

    // ---------- Field helpers ----------
    function validStatus(s) {
      return s in ['New', 'Contacted', 'Availability Checked', 'Awaiting Guest', 'Confirmed', 'Cancelled', 'Closed'];
    }
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optIn(d, k, values) {
      return !(k in d) || d[k] == null || d[k] in values;
    }
    function optInt(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }
    function optAddons(d) {
      return !('addons' in d) || d.addons == null || (d.addons is list && d.addons.size() <= 5
        && d.addons.hasOnly(['breakfast', 'extra_bed', 'sightseeing', 'decoration', 'late_checkout']));
    }

    // Every optional field a guest may send with an enquiry.
    function enquiryKeys() {
      return ['guest_name', 'phone', 'email', 'check_in', 'check_out', 'adults', 'children',
              'room_type', 'message', 'source', 'status', 'userId', 'created_at', 'updated_at',
              'enquiry_type', 'event_guests', 'pickup', 'addons', 'callback_time', 'promo_code',
              'referrer', 'utm_source', 'utm_medium', 'utm_campaign', 'privacy_consent_at', 'lang', 'channel'];
    }
    function validExtras(d) {
      return optIn(d, 'enquiry_type', ['stay', 'event', 'meeting'])
        && optInt(d, 'event_guests', 1, 1000)
        && optIn(d, 'pickup', ['none', 'station', 'bus', 'airport'])
        && optAddons(d)
        && optString(d, 'callback_time', 40)
        && optString(d, 'promo_code', 30)
        && optString(d, 'referrer', 200)
        && optString(d, 'utm_source', 100)
        && optString(d, 'utm_medium', 100)
        && optString(d, 'utm_campaign', 100)
        && optString(d, 'lang', 8)
        && optIn(d, 'channel', ['whatsapp', 'form']);
    }

    // Dates are optional on the enquiry form: either both are given (and sensible) or both are null.
    function validDates(d) {
      return (d.check_in == null && d.check_out == null)
        || (d.check_in is timestamp && d.check_out is timestamp
          && d.check_in > request.time - duration.value(2, 'd')
          && d.check_out > d.check_in
          && d.check_out < request.time + duration.value(730, 'd'));
    }

    function validNewEnquiry(d) {
      return d.keys().hasOnly(enquiryKeys())
        && d.guest_name is string && d.guest_name.size() > 0 && d.guest_name.size() <= 80
        && d.phone is string && d.phone.matches('^\\+?[0-9][0-9 \\-]{8,16}$')
        && (d.email == null || (d.email is string && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') && d.email.size() <= 120))
        && validDates(d)
        && d.adults is int && d.adults >= 1 && d.adults <= 20
        && d.children is int && d.children >= 0 && d.children <= 20
        && optString(d, 'room_type', 60)
        && optString(d, 'message', 1000)
        && d.source == 'website_form'
        && d.status == 'New'
        && d.created_at == request.time && d.updated_at == request.time
        && d.privacy_consent_at == request.time
        && validExtras(d)
        && (d.userId == null || (signedIn() && d.userId == request.auth.uid));
    }

    // Staff-entered records: demo data, phone calls, walk-ins and emails received.
    function validStaffEntry(d) {
      return canEdit()
        && d.keys().hasOnly(enquiryKeys().concat(['staff_notes', 'assigned_to', 'follow_up_at']))
        && d.source in ['demo', 'phone', 'walk_in', 'email']
        && validStatus(d.status)
        && d.guest_name is string && d.guest_name.size() > 0 && d.guest_name.size() <= 80
        && d.phone is string && d.phone.size() <= 20
        && d.check_in is timestamp && d.check_out is timestamp && d.check_out > d.check_in
        && d.adults is int && d.children is int
        && d.created_at is timestamp && d.updated_at is timestamp
        && d.userId == null
        && optString(d, 'staff_notes', 2000)
        && validExtras(d);
    }

    function isOwnerOf(data) { return signedIn() && data.userId == request.auth.uid; }

    match /booking_enquiries/{id} {
      allow create: if validNewEnquiry(request.resource.data) || validStaffEntry(request.resource.data);
      allow read: if isAdmin() || isOwnerOf(resource.data);

      // Staff: status, notes, assignee and follow-up date only.
      // Guest: their own online check-in details only.
      allow update: if (canEdit()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'staff_notes', 'updated_at', 'assigned_to', 'follow_up_at'])
          && validStatus(request.resource.data.status)
          && optString(request.resource.data, 'staff_notes', 2000)
          && optString(request.resource.data, 'assigned_to', 120)
          && (!('follow_up_at' in request.resource.data) || request.resource.data.follow_up_at == null || request.resource.data.follow_up_at is timestamp)
          && request.resource.data.updated_at == request.time)
        || (isOwnerOf(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkin', 'updated_at'])
          && request.resource.data.checkin is map
          && request.resource.data.checkin.keys().hasOnly(['arrival_time', 'guest_names', 'vehicle', 'notes', 'submitted_at'])
          && request.resource.data.updated_at == request.time);

      // Staff may delete demo records; guests may delete their own enquiries (download/delete my data).
      allow delete: if (canEdit() && resource.data.source == 'demo') || isOwnerOf(resource.data);

      // Messages between the guest and the hotel about this enquiry.
      match /messages/{m} {
        function parent() { return get(/databases/$(database)/documents/booking_enquiries/$(id)).data; }
        allow read: if isAdmin() || isOwnerOf(parent());
        allow create: if request.resource.data.keys().hasOnly(['text', 'from', 'author', 'created_at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.created_at == request.time
          && optString(request.resource.data, 'author', 80)
          && ((request.resource.data.from == 'staff' && canEdit()) || (request.resource.data.from == 'guest' && isOwnerOf(parent())));
        allow delete: if canEdit() && parent().source == 'demo';
      }

      // Who changed what and when (staff only, never edited).
      match /history/{h} {
        allow read: if isAdmin();
        allow create: if canEdit()
          && request.resource.data.keys().hasOnly(['change', 'by', 'at'])
          && request.resource.data.change is string && request.resource.data.change.size() <= 300
          && request.resource.data.by is string && request.resource.data.by.size() <= 120
          && request.resource.data.at == request.time;
        allow delete: if canEdit() && get(/databases/$(database)/documents/booking_enquiries/$(id)).data.source == 'demo';
      }
    }

    // Dates the hotel is fully booked (shown on the enquiry form).
    match /settings/availability {
      allow read: if true;
      allow write: if canEdit()
        && request.resource.data.keys().hasOnly(['blocked', 'updated_at', 'updated_by'])
        && request.resource.data.blocked is list && request.resource.data.blocked.size() <= 400
        && request.resource.data.updated_at == request.time;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'role', 'createdAt', 'preferences', 'saved_rooms'])
        && request.resource.data.role == 'guest'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'preferences', 'saved_rooms'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && (!('preferences' in request.resource.data) || request.resource.data.preferences is map)
        && (!('saved_rooms' in request.resource.data) || (request.resource.data.saved_rooms is list && request.resource.data.saved_rooms.size() <= 10));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Staff list (for assigning enquiries). Membership and roles are set only in the Firebase console.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'created_at', 'lang'])
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') && request.resource.data.email.size() <= 120
        && request.resource.data.consent == true
        && request.resource.data.created_at == request.time
        && optString(request.resource.data, 'lang', 8);
      allow read, delete: if isAdmin();
    }

    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'page', 'created_at'])
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.page is string && request.resource.data.page.size() <= 200
        && request.resource.data.created_at == request.time;
      allow read: if isAdmin();
      allow delete: if canEdit();
    }

    // Front-end errors, so broken pages are noticed (no personal data is sent).
    match /client_errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'page', 'ua', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.page is string && request.resource.data.page.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow delete: if canEdit();
    }

    // ---------- Website content managed from the admin panel ----------
    // Everyone can read it (it is the public website); only staff who can edit may change it.
    function optList(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= max);
    }
    function optNum(d, k) {
      return !(k in d) || d[k] == null || d[k] is int || d[k] is float;
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    match /rooms/{id} {
      allow read: if true;
      allow delete: if canEdit();
      allow create, update: if canEdit()
        && id.matches('^[a-z0-9][a-z0-9-]{0,59}$')
        && request.resource.data.keys().hasOnly(['name', 'category', 'summary', 'description', 'view', 'beds',
             'occupancy', 'guests', 'size', 'rate', 'features', 'amenities', 'images', 'order', 'published',
             'updated_at', 'updated_by'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && optString(request.resource.data, 'category', 60)
        && optString(request.resource.data, 'summary', 400)
        && optString(request.resource.data, 'description', 4000)
        && optString(request.resource.data, 'view', 80)
        && optString(request.resource.data, 'beds', 80)
        && optString(request.resource.data, 'occupancy', 80)
        && optString(request.resource.data, 'size', 40)
        && optString(request.resource.data, 'updated_by', 120)
        && optInt(request.resource.data, 'guests', 1, 50)
        && optNum(request.resource.data, 'rate')
        && optNum(request.resource.data, 'order')
        && optBool(request.resource.data, 'published')
        && optList(request.resource.data, 'features', 20)
        && optList(request.resource.data, 'amenities', 40)
        && optList(request.resource.data, 'images', 20);
    }

    match /offers/{code} {
      allow read: if true;
      allow delete: if canEdit();
      allow create, update: if canEdit()
        && code.matches('^[A-Za-z0-9_-]{1,30}$')
        && request.resource.data.keys().hasOnly(['code', 'title', 'tag', 'text', 'includes', 'image', 'room', 'type',
             'order', 'published', 'updated_at', 'updated_by'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && optString(request.resource.data, 'code', 30)
        && optString(request.resource.data, 'tag', 40)
        && optString(request.resource.data, 'text', 1000)
        && optString(request.resource.data, 'image', 80)
        && optString(request.resource.data, 'room', 60)
        && optString(request.resource.data, 'updated_by', 120)
        && optIn(request.resource.data, 'type', ['stay', 'event', 'meeting'])
        && optNum(request.resource.data, 'order')
        && optBool(request.resource.data, 'published')
        && optList(request.resource.data, 'includes', 12);
    }

    match /site/content {
      allow read: if true;
      allow write: if canEdit()
        && request.resource.data.keys().hasOnly(['seeded', 'categories', 'hero', 'gallery', 'banners', 'updated_at', 'updated_by'])
        && optBool(request.resource.data, 'seeded')
        && optList(request.resource.data, 'categories', 12)
        && optList(request.resource.data, 'hero', 12)
        && optList(request.resource.data, 'gallery', 120)
        && (!('banners' in request.resource.data) || request.resource.data.banners is map)
        && optString(request.resource.data, 'updated_by', 120);
    }

    // Photos uploaded in the admin panel, stored as compressed WebP/JPEG text (base64), max ~730 KB each.
    function validMediaInfo(d) {
      return d.mime in ['image/webp', 'image/jpeg', 'image/png']
        && d.name is string && d.name.size() <= 120
        && d.w is int && d.w > 0 && d.w <= 6000
        && d.h is int && d.h > 0 && d.h <= 6000
        && d.size is int && d.size > 0 && d.size <= 760000
        && optString(d, 'alt', 200)
        && optString(d, 'created_by', 120);
    }
    match /media/{id} {
      allow read: if true;
      allow delete: if canEdit();
      allow create, update: if canEdit()
        && id.matches('^[A-Za-z0-9_-]{6,40}$')
        && request.resource.data.keys().hasOnly(['data', 'mime', 'name', 'w', 'h', 'size', 'alt', 'created_at', 'created_by'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 1000000
        && validMediaInfo(request.resource.data);
    }
    match /media_meta/{id} {
      allow read: if true;
      allow delete: if canEdit();
      allow create, update: if canEdit()
        && id.matches('^[A-Za-z0-9_-]{6,40}$')
        && request.resource.data.keys().hasOnly(['mime', 'name', 'w', 'h', 'size', 'alt', 'created_at', 'created_by'])
        && validMediaInfo(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
